{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["jest"],
    "paths": {
      "@domain/*": ["./domain/*"],
      "@usecases/*": ["./usecases/*"],
      "@repositories/*": ["./repositories/*"],
      "@storage/*": ["./storage/*"],
      "@design/*": ["./design/*"],
      "@app/*": ["./app/*"]
    }
  },
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "**/__boundary-fixtures__/**"
  ]
}
