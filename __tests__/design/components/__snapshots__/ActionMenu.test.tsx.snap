  }
>
  <View
    accessibilityLabel="Workout menu"
    style={
      [
        {
          "alignItems": "center",
          "borderRadius": 18,
          "height": 36,
          "justifyContent": "center",
          "width": 36,
        },
        {
          "backgroundColor": "#1A1C1F",
        },
      ]
    }
    testID="action-menu"
  >
    <ViewManagerAdapter_ExpoUI
      layoutDirection="leftToRight"
      style={
        {
          "height": 36,
          "width": 36,
        }
      }
    >
      <ViewManagerAdapter_ExpoUI
        hasPrimaryAction={false}
        modifiers={
          [
            {
              "$type": "menuStyle",
              "style": "button",
            },
            {
              "$type": "buttonStyle",
              "style": "plain",
            },
            {
              "$type": "menuIndicator",
              "visibility": "hidden",
            },
          ]
        }
      >
        <ViewManagerAdapter_ExpoUI
          name="label"
        >
          <ViewManagerAdapter_ExpoUI
            modifiers={
              [
                {
                  "$type": "frame",
                  "height": 36,
                  "width": 36,
                },
                {
                  "$type": "contentShape",
                  "kind": undefined,
                  "shape": "rectangle",
                },
                {
                  "$type": "font",
                  "size": 20,
                },
                {
                  "$type": "foregroundStyle",
                  "color": "#C9CDD2",
                  "styleType": "color",
                },
              ]
            }
            onGlobalEvent={[Function]}
            systemName="ellipsis"
          />
        </ViewManagerAdapter_ExpoUI>
        <ViewManagerAdapter_ExpoUI
          label="Add exercise"
          onButtonPress={[MockFunction]}
          role="default"
          systemImage="plus"
          testID="action-menu-add"
        />
        <ViewManagerAdapter_ExpoUI
          label="Stop mesocycle"
          onButtonPress={[MockFunction]}
          role="destructive"
          systemImage="stop.circle"
          testID="action-menu-stop"
        />
      </ViewManagerAdapter_ExpoUI>
    </ViewManagerAdapter_ExpoUI>
  </View>
</RNCSafeAreaProvider>
`;

