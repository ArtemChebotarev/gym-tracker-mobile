{
  "expo": {
    "name": "Hybro",
    "slug": "gym-tracker-mobile",
    "version": "0.10.1",
    "scheme": "gymtracker",
    "orientation": "portrait",
    "icon": "./assets/hybro-icon-1024.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.artemchebotarov.hybro",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#CDFF57",
        "foregroundImage": "./assets/hybro-android-foreground-1024.png",
        "monochromeImage": "./assets/hybro-android-monochrome-1024.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.artemchebotarov.hybro"
    },
    "web": {
      "favicon": "./assets/hybro-icon-1024.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/hybro-splash-1024.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0E0F11"
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "sounds": ["./assets/sounds/rest-over.wav"]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-widgets",
        {
          "frequentUpdates": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4b58efc2-57fe-4f18-b047-5a87e9b8fe8c"
      }
    },
    "owner": "artemchebotarov"
  }
}
