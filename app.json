{
  "expo": {
    "name": "Hybro",
    "slug": "gym-tracker-mobile",
    "version": "1.0.0",
    "scheme": "gymtracker",
    "orientation": "portrait",
    "icon": "./assets/hybro-icon-1024.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.gym-tracker-mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#CDFF57",
        "foregroundImage": "./assets/hybro-android-foreground-1024.png",
        "monochromeImage": "./assets/hybro-android-monochrome-1024.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.gymtrackermobile"
    },
    "web": {
      "favicon": "./assets/hybro-icon-1024.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/hybro-splash-1024.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0E0F11",
          "dark": {
            "image": "./assets/hybro-splash-1024.png",
            "backgroundColor": "#0E0F11"
          }
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
